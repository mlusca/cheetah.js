{
    "name": "@carno.js/core",
    "version": "1.7.0",
    "description": "Bun-native TypeScript application framework with explicit architecture, dependency injection, decorators, and AOT/JIT-compiled HTTP routing",
    "keywords": [
        "bun",
        "typescript",
        "backend-framework",
        "bun-framework",
        "dependency-injection",
        "decorators",
        "aot",
        "jit"
    ],
    "homepage": "https://carnojs.github.io/carno.js/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/carnojs/carno.js.git",
        "directory": "packages/core"
    },
    "bugs": {
        "url": "https://github.com/carnojs/carno.js/issues"
    },
    "license": "MIT",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "build": "bun run build.ts",
        "compile": "rm -rf ./dist tsconfig.tsbuildinfo && tsc --build --force",
        "prepublishOnly": "bun run build"
    },
    "peerDependencies": {
        "bun": ">=1.0.0",
        "valibot": "^1.2.0"
    },
    "dependencies": {
        "reflect-metadata": "^0.2.2",
        "zod": "^4.3.5"
    },
    "devDependencies": {
        "esbuild-fix-imports-plugin": "^1.0.23",
